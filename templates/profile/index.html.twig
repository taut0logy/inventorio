{% extends 'base.html.twig' %}

{% block title %}Profile - Inventorio{% endblock %}

{% block body %}
<div {{ react_component('ProfilePage', {
    user: {
        name: user.name,
        email: user.email,
        avatarUrl: user.avatarUrl,
        theme: user.theme,
        locale: user.locale
    },
    translations: {
        account_settings: 'profile.title'|trans,
        general: 'profile.tab.general'|trans,
        security: 'profile.tab.security'|trans,
        profile_details: 'profile.details.title'|trans,
        profile_description: 'profile.details.description'|trans,
        full_name: 'profile.field.name'|trans,
        email: 'profile.field.email'|trans,
        email_help: 'profile.field.email_help'|trans,
        theme: 'profile.field.theme'|trans,
        language: 'profile.field.language'|trans,
        change_avatar: 'action.upload_avatar'|trans,
        avatar_help: 'profile.field.avatar_help'|trans,
        select_theme: 'profile.field.theme'|trans,
        select_language: 'profile.field.language'|trans,
        save_changes: 'action.save'|trans,
        change_password: 'password.title'|trans,
        password_description: 'password.description'|trans,
        current_password: 'password.current'|trans,
        new_password: 'password.new'|trans,
        confirm_password: 'password.confirm'|trans,
        update_password: 'password.title'|trans, 
        light: 'Light',
        dark: 'Dark',
        english: 'English (US)',
        bengali: 'Bengali'
    },
    updateProfilePath: path('app_profile_update'),
    changePasswordPath: path('app_profile_change_password'),
    csrfToken: csrf_token('profile_form'),
    passwordCsrfToken: csrf_token('change_password_form'),
    profileErrors: profile_errors|default({}),
    passwordErrors: password_errors|default({}),
    activeTab: active_tab|default('general'),
    hasPassword: user.password is not null
}) }}></div>
{% endblock %}
