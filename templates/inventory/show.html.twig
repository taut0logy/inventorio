{% extends 'base.html.twig' %}

{% block title %}{{ inventory.title }} - Inventorio{% endblock %}

{% block body %}
    <div {{ react_component('InventoryShowPage', {
        inventory: {
            id: inventory.id ~ '',
            title: inventory.title,
            description: inventory.description,
            isPublic: inventory.isPublic,
            imageUrl: inventory.imageUrl,
            category: {
                name: inventory.category.name,
                icon: inventory.category.iconUrl
            },
            tags: inventory.tags|map(t => ({ id: t.id ~ '', name: t.name })),
            fields: inventory.fields|map(f => ({
                id: f.id ~ '',
                type: f.type,
                label: f.label,
                description: f.description,
                position: f.position,
                hidden: f.hidden,
                required: f.required,
                regex: f.regex,
                min: f.min,
                max: f.max,
                options: f.options
            })),
            idGenerationConfig: inventory.idGenerationConfig,
            sharedWith: inventory.sharedWith|map(u => ({
                id: u.id ~ '',
                name: u.name,
                email: u.email,
                avatarUrl: u.avatarUrl
            })),
            creator: {
                id: inventory.creator.id ~ '',
                name: inventory.creator.name,
                avatarUrl: inventory.creator.avatarUrl
            },
            createdAt: inventory.createdAt|date('Y-m-d'),
            version: inventory.version
        },
        currentUser: app.user ? {
            id: app.user.id ~ '',
            name: app.user.name,
            avatarUrl: app.user.avatarUrl
        } : null,
        isAdmin: is_granted('ROLE_ADMIN'),
        isCreator: isCreator,
        isCollaborator: isCollaborator,
        canAddItem: canAddItem,
        canEditItem: canEditItem,
        canEditInventory: canEditInventory,
        canManageAccess: canManageAccess,
        hasRequestedAccess: hasRequestedAccess,
        items: (showDeleted ? deletedItems : inventory.items)|map(item => {
            id: item.id ~ '',
            customId: item.customId,
            likeCount: item.likeCount,
            version: item.version,
            fieldValues: item.fieldValuesArray,
            tags: item.tags|map(t => ({ id: t.id ~ '', name: t.name }))
        }),
        showDeleted: showDeleted,
        likedItemIds: likedItemIds|map(id => id ~ ''),
        inventoryLiked: inventoryLiked,
        inventoryLikeCount: inventoryLikeCount,
        inventoryViewCount: inventory.viewCount
    }) }}></div>
{% endblock %}
