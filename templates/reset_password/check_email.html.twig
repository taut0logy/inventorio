{% extends 'base.html.twig' %}

{% block title %}Check Email - Inventory App{% endblock %}

{% block body %}
<div {{ react_component('CheckEmailPage', {
    loginPath: path('app_login'),
    resetToken: resetToken,
    translations: {
        title: 'reset.check.title'|trans,
        desc: 'reset.check.desc'|trans,
        spam: 'reset.check.spam'|trans,
        expire: 'reset.check.expire'|trans,
        return: 'reset.check.return'|trans
    }
}) }}>
    {# Fallback while loading #}
    <div class="flex items-center justify-center min-h-[60vh]">
        <div class="animate-pulse text-muted-foreground">Loading...</div>
    </div>
</div>
{% endblock %}
