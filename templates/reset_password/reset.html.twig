{% extends 'base.html.twig' %}

{% block title %}Set New Password - Inventory App{% endblock %}

{% block body %}
<div {{ react_component('ResetPasswordPage', {
    loginPath: path('app_login'),
    translations: {
        title: 'reset.new.title'|trans,
        desc: 'reset.new.desc'|trans,
        new_password: 'password.new'|trans,
        confirm_password: 'password.confirm'|trans,
        strength: 'reset.new.strength'|trans,
        weak: 'reset.new.weak'|trans,
        medium: 'reset.new.medium'|trans,
        strong: 'reset.new.strong'|trans,
        process: 'reset.new.process'|trans,
        btn: 'reset.new.btn'|trans,
        min_length: 'val.password_min_6'|trans,
        mismatch: 'password.error.mismatch'|trans
    }
}) }}>
    {# Fallback while loading #}
    <div class="flex items-center justify-center min-h-[60vh]">
        <div class="animate-pulse text-muted-foreground">Loading...</div>
    </div>
</div>
{% endblock %}
