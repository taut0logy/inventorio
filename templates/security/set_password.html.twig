{% extends 'base.html.twig' %}

{% block title %}Set Password - Inventorio{% endblock %}

{% block body %}
<div {{ react_component('SetPasswordPage', {
    user: {
        name: user.name,
        email: user.email,
        avatarUrl: user.avatarUrl
    },
    errors: errors|default({}),
    csrfToken: csrf_token('set_password')
}) }}></div>
{% endblock %}
