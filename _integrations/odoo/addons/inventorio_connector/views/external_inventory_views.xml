<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="external_inventory_view_list" model="ir.ui.view">
        <field name="name">external.inventory.list</field>
        <field name="model">external.inventory</field>
        <field name="arch" type="xml">
            <list string="External Inventories">
                <field name="name"/>
                <field name="owner"/>
                <field name="category"/>
                <field name="total_items"/>
                <field name="sync_status" widget="badge" decoration-success="sync_status=='success'" decoration-danger="sync_status=='error'" decoration-warning="sync_status=='pending'"/>
                <field name="sync_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="external_inventory_view_form" model="ir.ui.view">
        <field name="name">external.inventory.form</field>
        <field name="model">external.inventory</field>
        <field name="arch" type="xml">
            <form string="External Inventory">
                <header>
                    <button name="action_sync_data" type="object" string="Sync Now" class="btn-primary"/>
                    <field name="sync_status" widget="statusbar" statusbar_visible="pending,success,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Inventory Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="API Configuration">
                            <field name="api_url" placeholder="https://your-app.com" widget="url"/>
                            <field name="api_token" password="True"/>
                        </group>
                        <group string="Inventory Info">
                            <field name="owner"/>
                            <field name="category"/>
                            <field name="is_public"/>
                            <field name="total_items"/>
                        </group>
                    </group>
                    <group>
                        <group string="Statistics">
                            <field name="view_count"/>
                            <field name="like_count"/>
                            <field name="total_value"/>
                            <field name="average_value"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                        </group>
                        <group string="Sync Info">
                            <field name="sync_date"/>
                            <field name="sync_error" invisible="sync_status != 'error'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Field Definitions">
                            <field name="fields_display" widget="html"/>
                        </page>
                        <page string="Statistics Details">
                            <field name="stats_display" widget="html"/>
                        </page>
                        <page string="Raw Response">
                            <field name="raw_response" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="external_inventory_action" model="ir.actions.act_window">
        <field name="name">External Inventories</field>
        <field name="res_model">external.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Import your first inventory from Inventorio
            </p>
            <p>
                Click the "Create" button to add an inventory. Paste the API Token
                and URL from your Inventorio application, then click "Sync Now".
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="inventorio_connector_menu_root" 
              name="Inventorio" 
              sequence="10"/>
    
    <menuitem id="inventorio_connector_menu_inventories" 
              name="External Inventories"
              parent="inventorio_connector_menu_root"
              action="external_inventory_action"
              sequence="10"/>
</odoo>
